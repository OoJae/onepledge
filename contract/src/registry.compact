// SPDX-License-Identifier: Apache-2.0
// OnePledge Registry, Wave 1 (v2).
//
// One pledge per receivable, across rival lenders, without any lender seeing another's book.
//
// Trust model for this version (stated, not hidden):
//   - A single tag authority, fixed at deployment, attests that a KSeF invoice exists and
//     computes its tag T = PRF(tagSecret, canonical KSeF number) off-chain. Uniqueness per
//     invoice therefore rests on that authority computing T deterministically. Wave 3 replaces
//     it with a verifiable threshold tag.
//   - The attestation is bound to the borrower's key, so a leaked attestation cannot be
//     front-run by someone else.
//
//   - Each attestation is bound to one deployment (this contract's address) and expires.
//
// What the public ledger learns from a pledge: the tag T, an opaque note commitment, the
// historic lender-registry root used, the attestation's expiry (a whole UTC day), and the
// pledge count. It never learns the invoice fields, the amount, the borrower, or which
// lender financed it.
//
// v2 security fix: v1 signed degradeToTransient(tag), which keeps only 248 of the tag's 256
// bits, so one attestation could be pledged again with a different last byte. v2 signs a
// SHA-256 digest of the full attestation body instead. See docs/security-review.md.

pragma language_version >= 0.22 && <= 0.23;
import CompactStandardLibrary;
import "schnorr" prefix Schnorr_;

export { Schnorr_SchnorrSignature };

// What the tag authority hands a borrower. `invoiceCommit` commits to the invoice fields
// (amount, debtor, due date) with a salt; only the financing lender receives the opening.
export struct Attestation {
  tag: Bytes<32>;
  invoiceCommit: Bytes<32>;
  // Face value in the registry's unit (grosz). The authority attests it because a borrowing-base
  // proof is only as honest as the amounts it sums; without this a borrower could claim any figure.
  // It is never disclosed: pledge binds it into the note commitment and nothing publishes it.
  amount: Uint<64>;
  acceptanceDay: Uint<32>;
  expiresAt: Uint<64>;
  borrower: Bytes<32>;
  signature: Schnorr_SchnorrSignature;
}

// The exact byte string the tag authority signs (as one SHA-256 digest). Every field is
// hashed whole, so no bit of any field can change without invalidating the signature.
// What a borrowing-base draw records. The floor is public on purpose: it is the whole claim.
export struct DrawRecord {
  round: Bytes<32>;
  floor: Uint<128>;
}

// One receivable in a borrowing-base pool: the opening of a note this lender is the lender of
// record for. Same four fields as a release opening; named separately because a pool holds four.
export struct PoolItem {
  tag: Bytes<32>;
  invoiceCommit: Bytes<32>;
  amount: Uint<64>;
  salt: Bytes<32>;
}

export struct AttestationBody {
  domain: Bytes<32>;
  registry: Bytes<32>;
  tag: Bytes<32>;
  invoiceCommit: Bytes<32>;
  amount: Uint<64>;
  acceptanceDay: Uint<32>;
  expiresAt: Uint<64>;
  borrower: Bytes<32>;
}

// The registrar committee. Admitting a lender takes `threshold` of its members, and no approval
// says which member gave it: a member proves it holds a committee leaf by Merkle path, so the only
// thing published is the root everyone already knows. The alternative — a Set the circuit calls
// member() on — would have to disclose the approver's key on every admission, which turns the
// committee into a public log of who signs off on which lender.
//
// Leaves bind the epoch, so a rotation retires the previous committee's leaves without the tree
// needing to delete anything (it cannot: it is append-only). An old leaf stays in an old historic
// root, but the circuit computes the leaf it demands from the *current* epoch, so a retired member
// has nothing to prove against.
export ledger registrars: HistoricMerkleTree<4, Bytes<32>>;
export ledger committeeEpoch: Counter;
// Approvals required. Sealed: a committee that could lower its own threshold is a 1-of-3.
export sealed ledger threshold: Uint<8>;
// action -> the approval nullifiers gathered for it. Nested so one member cannot approve twice:
// the nullifier is keyed on the member's secret, so it is both unlinkable and unforgeable.
export ledger proposals: Map<Bytes<32>, Set<Bytes<32>>>;
// Actions already carried out, so a used set of approvals cannot be replayed.
export ledger executed: Set<Bytes<32>>;
// The single tag authority for this registry version. Rotating it means a new deployment.
export sealed ledger tagAuthority: JubjubPoint;
// Acceptance-day window this deployment accepts, in days since 1970-01-01. The day is part of
// the KSeF number, so versions with disjoint windows never accept the same invoice.
export sealed ledger windowStart: Uint<32>;
export sealed ledger windowEnd: Uint<32>;

// Admitted lenders, as commitments. A pledge proves membership without revealing which one.
export ledger lenders: HistoricMerkleTree<10, Bytes<32>>;
// Each admitted lender's shielded encryption public key, so a borrower can encrypt the note opening
// to the lender it is pledging to. Admitted lenders are already a public set, so this adds nothing.
export ledger lenderEncryptionKeys: Map<Bytes<32>, Bytes<32>>;
// Encrypted note openings, keyed by the note commitment the pledge published. A lender finds its own
// by trying to decrypt each, the way shielded protocols do, so the ciphertext carries no recipient
// hint and the map never says which lender a delivery is for.
export ledger deliveries: Map<Bytes<32>, Opaque<"Uint8Array">>;
// Every tag ever pledged. Tags are never removed: a released pledge stays "used".
export ledger tags: Set<Bytes<32>>;
// Pledge notes: commit to (tag, lender, invoice commitment, salt).
export ledger notes: HistoricMerkleTree<16, Bytes<32>>;
// Nullifiers of released notes.
export ledger releases: Set<Bytes<32>>;
// A lender decides once per pledge note. Both sets are keyed by the same decision nullifier, which
// is unlinkable to the note and to the lender, exactly like a release nullifier. Which set it lands
// in is the decision, and that has to be public: a declined receivable must visibly become free again.
export ledger accepted: Set<Bytes<32>>;
export ledger declined: Set<Bytes<32>>;
// Borrowing-base draws: drawId -> the round and the floor that draw proved. A draw is the only
// place a lender says anything about how much its book is worth, and it says exactly one thing:
// at least this much. The drawId is unlinkable to the lender and to the receivables counted.
export ledger draws: Map<Bytes<32>, DrawRecord>;
export ledger pledgeCount: Counter;
export ledger releaseCount: Counter;
export ledger acceptCount: Counter;
export ledger declineCount: Counter;
export ledger drawCount: Counter;

witness localSecretKey(): Bytes<32>;
witness getAttestation(): Attestation;
witness getLenderPath(): MerkleTreePath<10, Bytes<32>>;
witness getRegistrarPath(): MerkleTreePath<4, Bytes<32>>;
witness getNoteSalt(): Bytes<32>;
witness getNoteOpening(): [Bytes<32>, Bytes<32>, Uint<64>, Bytes<32>];
witness getNotePath(): MerkleTreePath<16, Bytes<32>>;
witness getPool(): Vector<4, PoolItem>;
witness getPoolPaths(): Vector<4, MerkleTreePath<16, Bytes<32>>>;

// `committee` holds the three registrar key commitments (registrarKey(secret)), not the secrets, so
// a deployer need not hold any of them. In this demo all three are the deployer's — said plainly in
// the README and the threat model rather than dressed up as decentralisation.
constructor(authority: JubjubPoint, start: Uint<32>, end: Uint<32>, committee: Vector<3, Bytes<32>>) {
  assert(start < end, "Empty acceptance window");
  assert(!isIdentity(authority), "Tag authority key is the identity point");
  assert(committee[0] != committee[1] && committee[1] != committee[2] && committee[0] != committee[2],
         "Committee members must be distinct");
  tagAuthority = disclose(authority);
  windowStart = disclose(start);
  windowEnd = disclose(end);
  threshold = 2;
  registrars.insert(disclose(committeeLeaf(0, committee[0])));
  registrars.insert(disclose(committeeLeaf(0, committee[1])));
  registrars.insert(disclose(committeeLeaf(0, committee[2])));
}

pure circuit isIdentity(p: JubjubPoint): Boolean {
  return jubjubPointX(p) == 0 && jubjubPointY(p) == 1;
}

export pure circuit registrarKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "onepledge:registrar:v1"), sk]);
}

struct CommitteeLeaf {
  domain: Bytes<32>;
  epoch: Uint<64>;
  member: Bytes<32>;
}

// A committee member's leaf for one epoch. Binding the epoch is what retires a rotated-out member
// from an append-only tree.
export pure circuit committeeLeaf(epoch: Uint<64>, member: Bytes<32>): Bytes<32> {
  return persistentHash<CommitteeLeaf>(CommitteeLeaf {
    domain: pad(32, "onepledge:committee:v1"),
    epoch: epoch,
    member: member
  });
}

struct AdmitActionBody {
  domain: Bytes<32>;
  epoch: Uint<64>;
  lender: Bytes<32>;
  encryptionKey: Bytes<32>;
}

export pure circuit admitAction(epoch: Uint<64>, lender: Bytes<32>, encryptionKey: Bytes<32>): Bytes<32> {
  return persistentHash<AdmitActionBody>(AdmitActionBody {
    domain: pad(32, "onepledge:action:admit:v1"),
    epoch: epoch,
    lender: lender,
    encryptionKey: encryptionKey
  });
}

struct RotateActionBody {
  domain: Bytes<32>;
  epoch: Uint<64>;
  member0: Bytes<32>;
  member1: Bytes<32>;
  member2: Bytes<32>;
}

export pure circuit rotateAction(epoch: Uint<64>, member0: Bytes<32>, member1: Bytes<32>,
                                 member2: Bytes<32>): Bytes<32> {
  return persistentHash<RotateActionBody>(RotateActionBody {
    domain: pad(32, "onepledge:action:rotate:v1"),
    epoch: epoch,
    member0: member0,
    member1: member1,
    member2: member2
  });
}

// One member's approval of one action. Keyed on the member's secret, so it is unforgeable, and
// domain-separated from release and decision nullifiers so none of the three can ever collide.
export pure circuit approvalNullifier(action: Bytes<32>, registrarSecret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "onepledge:approval:v1"), action, registrarSecret]);
}

export pure circuit borrowerKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "onepledge:borrower:v1"), sk]);
}

export pure circuit lenderKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "onepledge:lender:v1"), sk]);
}

struct NoteBody {
  domain: Bytes<32>;
  tag: Bytes<32>;
  lender: Bytes<32>;
  invoiceCommit: Bytes<32>;
  amount: Uint<64>;
  salt: Bytes<32>;
}

export pure circuit noteCommitment(tag: Bytes<32>, lender: Bytes<32>, invoiceCommit: Bytes<32>,
                                   amount: Uint<64>, salt: Bytes<32>): Bytes<32> {
  const body = NoteBody {
    domain: pad(32, "onepledge:note:v2"),
    tag: tag,
    lender: lender,
    invoiceCommit: invoiceCommit,
    amount: amount,
    salt: salt
  };
  return persistentHash<NoteBody>(body);
}

// Marks one lender's decision on one note. Domain-separated from the release nullifier so the two
// can never collide, and keyed on the lender secret so only the lender of record can produce it.
export pure circuit decisionNullifier(note: Bytes<32>, lenderSecret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "onepledge:decision:v1"), note, lenderSecret]);
}

export pure circuit releaseNullifier(note: Bytes<32>, lenderSecret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "onepledge:release:v1"), note, lenderSecret]);
}

// Identifies one lender's borrowing-base draw for one round, without naming the lender. Two rounds
// produce unlinkable ids; one round produces the same id twice, which is how a lender is held to one
// draw per round.
export pure circuit drawId(round: Bytes<32>, lenderSecret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "onepledge:draw:v1"), round, lenderSecret]);
}

// The one-field message the tag authority signs: a SHA-256 digest of the whole body, reduced
// to a Field. The digest keeps 248 of its 256 bits, which is fine for a hash output; v1's bug
// was truncating the raw tag, not a digest of it.
export pure circuit attestationMessage(registry: Bytes<32>, tag: Bytes<32>, invoiceCommit: Bytes<32>,
                                       amount: Uint<64>, acceptanceDay: Uint<32>, expiresAt: Uint<64>,
                                       borrower: Bytes<32>): Vector<1, Field> {
  const body = AttestationBody {
    domain: pad(32, "onepledge:attest:v3"),
    registry: registry,
    tag: tag,
    invoiceCommit: invoiceCommit,
    amount: amount,
    acceptanceDay: acceptanceDay,
    expiresAt: expiresAt,
    borrower: borrower
  };
  return [degradeToTransient(persistentHash<AttestationBody>(body))];
}

export pure circuit schnorrChallenge(ann_x: Field, ann_y: Field, pk_x: Field, pk_y: Field,
                                     msg: Vector<1, Field>): Field {
  return Schnorr_schnorrChallenge1(ann_x, ann_y, pk_x, pk_y, msg);
}

// --- Registrar committee ------------------------------------------------------------------------

// One member records its approval of `action`. Shared by every approve circuit so the membership
// proof and the double-approval check exist once.
circuit recordApproval(action: Bytes<32>): [] {
  const a = disclose(action);
  assert(!executed.member(a), "Action already executed");

  // Membership by Merkle path against the current epoch's leaf: the approver's key never leaves
  // the circuit, so an approval cannot be attributed to a member.
  const sk = localSecretKey();
  const leaf = committeeLeaf(committeeEpoch, registrarKey(sk));
  const path = getRegistrarPath();
  assert(path.leaf == leaf, "Registrar path does not match this committee member");
  assert(registrars.checkRoot(disclose(merkleTreePathRoot<4, Bytes<32>>(path))),
         "Not a member of the registrar committee");

  const nullifier = disclose(approvalNullifier(a, sk));
  if (!proposals.member(a)) {
    proposals.insertDefault(a);
  }
  assert(!proposals.lookup(a).member(nullifier), "Already approved by this committee member");
  proposals.lookup(a).insert(nullifier);
}

// Consumes the approvals for `action`. Deliberately takes no witness: once `threshold` members have
// approved, the authorisation is complete and who submits the execution is immaterial.
circuit consumeApprovals(action: Bytes<32>): [] {
  const a = disclose(action);
  assert(!executed.member(a), "Action already executed");
  assert(proposals.member(a), "No approvals recorded for this action");
  assert(proposals.lookup(a).size() >= threshold as Uint<64>, "Below the registrar threshold");
  executed.insert(a);
  // The nullifiers have done their work; `executed` is what blocks a replay from here on.
  proposals.remove(a);
}

// A committee member approves admitting a lender by its key commitment (lenderKey(lenderSecret)).
// Both the lender key and its encryption key are public arguments, and they are bound into the
// action, so the chain records exactly what was approved rather than an opaque hash.
export circuit approveAdmit(lender: Bytes<32>, encryptionKey: Bytes<32>): [] {
  assert(!lenderEncryptionKeys.member(disclose(lender)), "Lender already admitted");
  recordApproval(admitAction(committeeEpoch, lender, encryptionKey));
}

export circuit executeAdmit(lender: Bytes<32>, encryptionKey: Bytes<32>): [] {
  assert(!lenderEncryptionKeys.member(disclose(lender)), "Lender already admitted");
  consumeApprovals(admitAction(committeeEpoch, lender, encryptionKey));
  lenders.insert(disclose(lender));
  lenderEncryptionKeys.insert(disclose(lender), disclose(encryptionKey));
}

// A committee member approves replacing the whole committee. Two approvals are needed, which closes
// F68 from the security review: a single registrar can no longer hand the role to a wrong key and
// lock admissions. The action binds the current epoch, so a rotation also voids every pending
// proposal — approvals gathered under the old committee must not carry into the new one.
export circuit approveRotate(members: Vector<3, Bytes<32>>): [] {
  recordApproval(rotateAction(committeeEpoch, members[0], members[1], members[2]));
}

export circuit executeRotate(members: Vector<3, Bytes<32>>): [] {
  assert(members[0] != members[1] && members[1] != members[2] && members[0] != members[2],
         "Committee members must be distinct");
  consumeApprovals(rotateAction(committeeEpoch, members[0], members[1], members[2]));
  const next = (committeeEpoch + 1) as Uint<64>;
  committeeEpoch.increment(1);
  registrars.insert(disclose(committeeLeaf(next, members[0])));
  registrars.insert(disclose(committeeLeaf(next, members[1])));
  registrars.insert(disclose(committeeLeaf(next, members[2])));
}

// Borrower pledges an attested receivable to an admitted lender.
// Runs with the borrower's secret, the attestation, and the lender's public key (the registry
// path is read from the public lender tree). Returns the note commitment.
// `delivery` is the note opening encrypted to the lender's encryption key, built off-chain. The
// circuit cannot constrain an opaque value, so a borrower could post garbage; the lender decrypts,
// recomputes the note commitment, sees it does not match, and declines. That is what the void path
// is for, so nothing new is needed to handle it.
export circuit pledge(lender: Bytes<32>, delivery: Opaque<"Uint8Array">): Bytes<32> {
  const att = getAttestation();

  // 1. The attestation belongs to this borrower (anti-front-running).
  assert(att.borrower == borrowerKey(localSecretKey()), "Attestation is bound to a different borrower");

  // 2. The tag authority signed exactly these fields, for this registry.
  assert(!isIdentity(tagAuthority), "Tag authority key is the identity point");
  Schnorr_schnorrVerify<1>(
    attestationMessage(kernel.self().bytes, att.tag, att.invoiceCommit, att.amount, att.acceptanceDay,
                       att.expiresAt, att.borrower),
    att.signature,
    tagAuthority);

  // 3. The attestation has not expired. The expiry is a public argument to the block-time check.
  assert(blockTimeLt(disclose(att.expiresAt)), "Attestation expired");

  // 4. The invoice falls inside this deployment's acceptance window. Assert conditions are
  //    proven, not published.
  assert(att.acceptanceDay >= windowStart, "Invoice accepted before this registry's window");
  assert(att.acceptanceDay < windowEnd, "Invoice accepted after this registry's window");

  // 5. The lender is admitted, proven against a historic registry root without revealing it.
  const lenderPath = getLenderPath();
  assert(lenderPath.leaf == lender, "Lender path does not match the lender");
  assert(lenders.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(lenderPath))), "Lender is not admitted");

  // 6. One pledge per receivable, forever.
  const tag = disclose(att.tag);
  assert(!tags.member(tag), "Receivable already pledged");
  tags.insert(tag);

  // 7. Record a note only the lender of record can later release.
  const note = disclose(noteCommitment(att.tag, lender, att.invoiceCommit, att.amount, getNoteSalt()));
  notes.insert(note);
  deliveries.insert(note, disclose(delivery));
  pledgeCount.increment(1);
  return note;
}

// Lender of record releases a pledge (for example, the invoice was paid). The tag stays in
// `tags`; only an unlinkable nullifier is published.
export circuit release(): [] {
  const sk = localSecretKey();
  const [tag, invoiceCommit, amount, salt] = getNoteOpening();
  const note = noteCommitment(tag, lenderKey(sk), invoiceCommit, amount, salt);

  const notePath = getNotePath();
  assert(notePath.leaf == note, "Note path does not match the note opening");
  assert(notes.checkRoot(disclose(merkleTreePathRoot<16, Bytes<32>>(notePath))), "Unknown pledge note");

  const nullifier = disclose(releaseNullifier(note, sk));
  assert(!releases.member(nullifier), "Pledge already released");
  releases.insert(nullifier);
  releaseCount.increment(1);
}

// A lender proves it is the lender of record for a note, the same way release() does: it recomputes
// the note commitment from its own secret, so no other party can decide on its behalf.
circuit decideOnOwnNote(): [Bytes<32>, Bytes<32>] {
  const sk = localSecretKey();
  const [tag, invoiceCommit, amount, salt] = getNoteOpening();
  const note = noteCommitment(tag, lenderKey(sk), invoiceCommit, amount, salt);

  const notePath = getNotePath();
  assert(notePath.leaf == note, "Note path does not match the note opening");
  assert(notes.checkRoot(disclose(merkleTreePathRoot<16, Bytes<32>>(notePath))), "Unknown pledge note");

  const decision = disclose(decisionNullifier(note, sk));
  assert(!accepted.member(decision), "Pledge already accepted");
  assert(!declined.member(decision), "Pledge already declined");
  // The tag is returned undisclosed on purpose. Only declinePledge discloses it, so accepting can
  // never say which receivable was accepted even if a future edit stops eliminating the dead value.
  return [decision, tag];
}

// The named lender takes the pledge. Until this runs, a borrower's pledge is a one-sided claim.
export circuit acceptPledge(): [] {
  const [decision, _tag] = decideOnOwnNote();
  accepted.insert(decision);
  acceptCount.increment(1);
}

// The named lender refuses the pledge, and the receivable becomes pledgeable again. This is the void
// path: without it a borrower could burn any invoice forever by pledging it to a lender that never
// agreed to finance it. The tag was already public from the pledge, so removing it discloses nothing
// new about the invoice; it only stops the registry claiming the receivable is still encumbered.
export circuit declinePledge(): [] {
  const [decision, tag] = decideOnOwnNote();
  declined.insert(decision);
  tags.remove(disclose(tag));
  declineCount.increment(1);
}

// --- Borrowing base -----------------------------------------------------------------------------
//
// A factor that finances receivables is itself financed, and its funding bank wants to know the
// book behind a drawdown is real and large enough. Showing it means handing over the client list,
// the invoices and the amounts — which is the same disclosure problem this registry exists to
// avoid, one level up.
//
// So a lender proves instead: four receivables pledged to me, each one on this ledger, together
// worth at least `floor`. The amounts stay private, which notes they are stays private, and the
// prover is authorised structurally — it recomputes each note commitment from its own secret, so
// only the lender of record for all four can produce the proof.
//
// The pool is fixed at four because a depth-16 path plus a note recompute costs about 4.8 MB of
// prover key per receivable. Larger books accumulate instead: run a draw per round over a rolling
// four, or raise N and pay for it. Documented in the README rather than hidden behind a constant.
//
// What this still cannot prove, and the reason is the same each time: `accepted`, `declined` and
// `releases` are Sets, and a Compact circuit can only ask a Set about a key it discloses. So a draw
// cannot require that its four receivables were accepted, nor that they were not later declined or
// released, without publishing the decision nullifier and tying the draw back to the accepts behind
// it — which would group a lender's book, the one thing this contract exists to prevent. A lender
// can therefore include a receivable it declined or has already been paid for. Stated in the threat
// model as a limitation, not worked around.

// Checks one pool item and returns its tag and amount, both undisclosed: the caller needs the tags
// only to prove the four receivables are different ones, and the amount only to add it up.
circuit checkPoolItem(lender: Bytes<32>, item: PoolItem,
                      path: MerkleTreePath<16, Bytes<32>>): [Bytes<32>, Uint<64>] {
  const note = noteCommitment(item.tag, lender, item.invoiceCommit, item.amount, item.salt);
  assert(path.leaf == note, "Pool note path does not match its opening");
  assert(notes.checkRoot(disclose(merkleTreePathRoot<16, Bytes<32>>(path))), "Unknown pool note");
  return [item.tag, item.amount];
}

export circuit proveBorrowingBase(round: Bytes<32>, floor: Uint<128>): [] {
  const sk = localSecretKey();
  const lender = lenderKey(sk);
  const pool = getPool();
  const paths = getPoolPaths();

  const [tag0, amount0] = checkPoolItem(lender, pool[0], paths[0]);
  const [tag1, amount1] = checkPoolItem(lender, pool[1], paths[1]);
  const [tag2, amount2] = checkPoolItem(lender, pool[2], paths[2]);
  const [tag3, amount3] = checkPoolItem(lender, pool[3], paths[3]);

  // Four distinct *receivables*, which means four distinct tags — not four distinct notes.
  //
  // Comparing note commitments was the first version of this check and it was unsound. Declining a
  // pledge frees the tag but leaves the note in the append-only tree, and the declining lender keeps
  // its opening, so one invoice pledged, declined and pledged again to the same lender yields two
  // different commitments for one receivable. A lender could pad its book by repeating that: a test
  // proved a floor of 20,000,000 grosz against a book genuinely worth 11,000,000. The tag identifies
  // the receivable, so the tag is what has to be unique.
  //
  // Both forms cost the same and neither discloses anything — the tags are private witnesses and
  // only their inequality is proven.
  assert(tag0 != tag1 && tag0 != tag2 && tag0 != tag3, "A receivable appears twice in the pool");
  assert(tag1 != tag2 && tag1 != tag3 && tag2 != tag3, "A receivable appears twice in the pool");

  // Arithmetic widens rather than wrapping, so the sum cannot overflow into a passing total.
  const total = amount0 + amount1 + amount2 + amount3;
  assert((total as Uint<128>) >= floor, "Pool does not clear the floor");

  const id = disclose(drawId(round, sk));
  assert(!draws.member(id), "A borrowing base was already proven for this round");
  draws.insert(id, DrawRecord { round: disclose(round), floor: disclose(floor) });
  drawCount.increment(1);
}
