// SPDX-License-Identifier: Apache-2.0
// Schnorr signature verification over Jubjub for Compact toolchain 0.31.1 (ledger 8).
//
// Adapted from midnightntwrk/example-zkloan `contract/src/schnorr.compact`
// (Copyright (C) 2025 Midnight Foundation, Apache-2.0). Public networks do not yet
// ship `jubjubSchnorrVerify` (toolchain 0.32+/ledger 9), so this polyfill is used
// until they do. Changes from upstream: the challenge helper is sized for the
// OnePledge attestation message (5 fields).

module schnorr {
  import CompactStandardLibrary;

  export struct SchnorrSignature {
    announcement: JubjubPoint;
    response: Field;
  }

  struct SchnorrHashInput<#n> {
    ann_x: Field;
    ann_y: Field;
    pk_x: Field;
    pk_y: Field;
    msg: Vector<n, Field>;
  }

  // Quotient and remainder of the challenge hash divided by 2^248, supplied by
  // the prover and checked below over the integers.
  witness getSchnorrReduction(challengeHash: Field): [Uint<7>, Uint<248>];

  export circuit schnorrVerify<#n>(msg: Vector<n, Field>, signature: SchnorrSignature, pk: JubjubPoint): [] {
    const {announcement, response} = signature;
    const cFull: Field = transientHash<SchnorrHashInput<n>>(
      SchnorrHashInput<n> {
        ann_x: jubjubPointX(announcement),
        ann_y: jubjubPointY(announcement),
        pk_x: jubjubPointX(pk),
        pk_y: jubjubPointY(pk),
        msg: msg
      });
    const TWO_248: Field =
      452312848583266388373324160190187140051835877600158453279131187530910662656 as Field;
    const [q, cTruncated] = getSchnorrReduction(cFull);
    // floor((BLS12-381 scalar prime - 1) / 2^248) == 115, so an honest quotient is
    // in [0, 115]. Bounding it stops a prover from choosing any challenge and
    // solving for a matching quotient modulo the field prime.
    assert(disclose(q) < 116, "Schnorr quotient out of range");
    assert(disclose(q) * TWO_248 + (disclose(cTruncated) as Field) == cFull, "Invalid challenge reduction");
    const c: Field = disclose(cTruncated) as Field;
    const lhs: JubjubPoint = ecMulGenerator(response);
    const rhs: JubjubPoint = ecAdd(announcement, ecMul(pk, c));
    assert(jubjubPointX(lhs) == jubjubPointX(rhs) && jubjubPointY(lhs) == jubjubPointY(rhs),
           "Invalid attestation signature");
  }

  export pure circuit schnorrChallenge5(ann_x: Field, ann_y: Field, pk_x: Field, pk_y: Field,
                                        msg: Vector<5, Field>): Field {
    return transientHash<SchnorrHashInput<5>>(
      SchnorrHashInput<5> { ann_x: ann_x, ann_y: ann_y, pk_x: pk_x, pk_y: pk_y, msg: msg });
  }
}
